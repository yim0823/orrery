#!/bin/sh
# Keep organization-specific identifiers out of this repository.
#
# The denylist lives OUTSIDE the repo, because the list itself is the sensitive part.
# If it cannot be found the commit is refused rather than allowed: a guard that silently
# disables itself on a new machine is worse than no guard, because you stop checking by
# hand once you believe something else is watching.
#
# Contributing from outside the original organization? You have nothing to hide, so an
# empty file is the correct denylist:
#
#     touch ~/.orrery-denylist
#     export ORRERY_DENYLIST=~/.orrery-denylist
#
# or set it once, permanently:
#
#     git config hooks.denylist ~/.orrery-denylist
set -eu

DENYLIST="${ORRERY_DENYLIST:-$(git config --get hooks.denylist || true)}"
if [ -z "${DENYLIST}" ]; then
  DENYLIST="$HOME/.orrery-denylist"
fi

if [ ! -f "$DENYLIST" ]; then
  echo "🔴 commit refused: no denylist found at $DENYLIST"
  echo
  echo "   This repository must not contain organization-specific identifiers, and the"
  echo "   check that enforces that needs a list. It refuses to run without one rather"
  echo "   than passing, so that it cannot quietly stop working."
  echo
  echo "   If you have nothing to exclude, an empty file is the right answer:"
  echo "     touch \"$DENYLIST\""
  echo
  echo "   Or point it somewhere else:"
  echo "     git config hooks.denylist /path/to/denylist.txt"
  exit 1
fi

if ! uv run python scripts/check_identifiers.py --denylist "$DENYLIST" >/tmp/orrery-scan.txt 2>&1; then
  echo "🔴 commit refused: forbidden identifiers found."
  cat /tmp/orrery-scan.txt
  echo
  echo "   This repository is published. Keep that content outside it."
  exit 1
fi
exit 0
