#!/bin/sh
# Keep organization-specific identifiers out of this repository.
#
# The denylist lives OUTSIDE the repo, because the list itself is the sensitive part.
# If it cannot be found the commit is refused rather than allowed: a guard that silently
# disables itself on a new machine is worse than no guard, because you stop checking by
# hand once you believe something else is watching.
#
# Contributing from outside the original organization? You have nothing to hide, so an
# empty file is the correct denylist:
#
#     touch ~/.orrery-denylist
#     export ORRERY_DENYLIST=~/.orrery-denylist
#
# or set it once, permanently:
#
#     git config hooks.denylist ~/.orrery-denylist
set -eu

DENYLIST="${ORRERY_DENYLIST:-$(git config --get hooks.denylist || true)}"
if [ -z "${DENYLIST}" ]; then
  DENYLIST="$HOME/.orrery-denylist"
fi

if [ ! -f "$DENYLIST" ]; then
  echo "🔴 commit refused: no denylist found at $DENYLIST"
  echo
  echo "   This repository must not contain organization-specific identifiers, and the"
  echo "   check that enforces that needs a list. It refuses to run without one rather"
  echo "   than passing, so that it cannot quietly stop working."
  echo
  echo "   If you have nothing to exclude, an empty file is the right answer:"
  echo "     touch \"$DENYLIST\""
  echo
  echo "   Or point it somewhere else:"
  echo "     git config hooks.denylist /path/to/denylist.txt"
  exit 1
fi

if ! uv run python scripts/check_identifiers.py --denylist "$DENYLIST" >/tmp/orrery-scan.txt 2>&1; then
  echo "🔴 push refused: forbidden identifiers found in the working tree."
  cat /tmp/orrery-scan.txt
  echo
  echo "   This repository is published. Keep that content outside it."
  exit 1
fi

# The tree scan cannot see what an earlier commit added and a later one removed: that is
# still in the history this push publishes. Scan every commit being pushed, messages too.
zero=0000000000000000000000000000000000000000
while read -r local_ref local_sha remote_ref remote_sha; do
  [ "$local_sha" = "$zero" ] && continue          # deleting a branch publishes nothing
  case "$local_ref" in
    refs/tags/*)
      # an annotated tag carries its own message; a lightweight tag is just a commit
      if [ "$(git cat-file -t "$local_sha")" = "tag" ]; then
        if ! git cat-file -p "$local_sha" | uv run python scripts/check_identifiers.py \
            --denylist "$DENYLIST" --stdin >/tmp/orrery-scan-tag.txt 2>&1; then
          echo "🔴 push refused: forbidden identifiers in tag $local_ref."
          cat /tmp/orrery-scan-tag.txt
          exit 1
        fi
        local_sha=$(git rev-parse "$local_sha^{commit}")
      fi
      ;;
  esac
  if [ "$remote_sha" = "$zero" ]; then
    range="$local_sha --not --remotes"            # new branch: whatever no remote has yet
  else
    range="$remote_sha..$local_sha"
  fi
  # shellcheck disable=SC2086
  if ! uv run python scripts/check_identifiers.py --denylist "$DENYLIST" --git-range "$range" \
      >/tmp/orrery-scan-range.txt 2>&1; then
    echo "🔴 push refused: forbidden identifiers in commits being pushed ($local_ref)."
    cat /tmp/orrery-scan-range.txt
    echo
    echo "   Rewrite those commits before pushing; removing the token in a new commit is not enough."
    exit 1
  fi
done
exit 0
