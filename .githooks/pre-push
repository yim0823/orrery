#!/bin/sh
# 사내 식별자가 엔진 리포에 들어가는 것을 막는다.
# denylist는 리포 바깥에 산다. 없으면 통과가 아니라 차단한다(fail closed).
DENYLIST="${ORRERY_DENYLIST:-$HOME/감사할따름/orrery-사내자료/denylist.txt}"

if [ ! -f "$DENYLIST" ]; then
  echo "🔴 커밋 차단: denylist를 찾을 수 없습니다 → $DENYLIST"
  echo "   이 검사 없이는 커밋하지 않습니다. 경로를 확인하거나 ORRERY_DENYLIST로 지정하세요."
  exit 1
fi

if ! uv run python scripts/check_identifiers.py --denylist "$DENYLIST" >/tmp/orrery-scan.txt 2>&1; then
  echo "🔴 커밋 차단: 사내 식별자가 발견되었습니다."
  cat /tmp/orrery-scan.txt
  echo ""
  echo "   이 리포는 공개 엔진입니다. 해당 내용은 리포 바깥에 두세요."
  exit 1
fi
exit 0
